# GitHub uses this file to populate the "Cite this repository" sidebar
# entry on the repo home. Format spec: https://citation-file-format.github.io/

cff-version: 1.2.0
title: "shinytone: A Citation Tone Research Hub"
message: >
  If you use shinytone in published work, please cite both this software
  (Xu & Zhang 2026, DOI 10.5281/zenodo.22632508) and the methodology paper
  it implements (Xu & Zhang 2024, JASA), listed first under `references`.
  A tutorial paper on the software is in preparation and will be added here.
type: software
authors:
  - family-names: Xu
    given-names: Chenzi
    orcid: "https://orcid.org/0000-0001-6506-4513"
    affiliation: "Nanyang Technological University, Singapore"
  - family-names: Zhang
    given-names: Cong
    orcid: "https://orcid.org/0000-0002-2561-2113"
    affiliation: "Newcastle University, United Kingdom"
doi: 10.5281/zenodo.22632509
identifiers:
  - type: doi
    value: 10.5281/zenodo.22632508
    description: "Concept DOI (resolves to the latest version)"
  - type: doi
    value: 10.5281/zenodo.22632509
    description: "Version 1.0.0"
repository-code: "https://github.com/chenchenzi/citationtone_hub"
url: "https://chenchenzi.github.io/citationtone_hub/"
license: GPL-3.0-or-later
version: 1.0.0
date-released: 2026-09-07
keywords:
  - citation tone
  - tonal phonetics
  - f0 normalisation
  - growth curve analysis
  - generalised additive mixed models
  - Chao tone numerals
  - R package
  - Shiny

references:
  - type: article
    title: "A cross-linguistic review of citation tone production studies: Methodology and recommendations"
    authors:
      - family-names: Xu
        given-names: Chenzi
      - family-names: Zhang
        given-names: Cong
    journal: "The Journal of the Acoustical Society of America"
    year: 2024
    volume: 156
    issue: 4
    start: 2538
    end: 2565
    doi: "10.1121/10.0032356"
    notes: >
      Methodology paper: the review whose recommendations shinytone
      implements. Please cite alongside the software.
  - type: article
    title: "Plastic Mandarin tones: regional identity in prosody"
    authors:
      - family-names: Xu
        given-names: Chenzi
    journal: "Phonetica"
    year: 2025
    volume: 82
    issue: 5
    start: 331
    end: 362
    doi: "10.1515/phon-2025-0001"
    notes: >
      Source of the bundled sample_f0 dataset.
